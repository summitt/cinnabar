{
    "head": {
        "type": "header",
        "description": "Cinnabar Corners"
    },
    "radius": {
        "type": "spinbutton",
        "default": 12,
        "min": 0,
        "max": 48,
        "step": 1,
        "units": "px",
        "description": "Corner radius"
    },
    "border": {
        "type": "spinbutton",
        "default": 2,
        "min": 0,
        "max": 10,
        "step": 1,
        "units": "px",
        "description": "Border width"
    },
    "color-focused": {
        "type": "colorchooser",
        "default": "rgb(10,132,255)",
        "description": "Border color (focused window)"
    },
    "gradient": {
        "type": "checkbox",
        "default": false,
        "description": "Gradient border (focused window)"
    },
    "color-focused-to": {
        "type": "colorchooser",
        "default": "rgb(191,90,242)",
        "description": "Gradient end color"
    },
    "color-unfocused": {
        "type": "colorchooser",
        "default": "rgb(58,58,68)",
        "description": "Border color (unfocused window)"
    },
    "skip-csd": {
        "type": "checkbox",
        "default": true,
        "description": "Leave client-side decorated windows alone (GTK apps already round and border themselves)"
    },
    "animate": {
        "type": "checkbox",
        "default": true,
        "description": "Animate the gradient border (rotate the accent around the focused window)"
    },
    "speed": {
        "type": "spinbutton",
        "default": 8,
        "min": 1,
        "max": 60,
        "step": 1,
        "units": "s / turn",
        "description": "Rotation time"
    },
    "fps": {
        "type": "spinbutton",
        "default": 30,
        "min": 5,
        "max": 60,
        "step": 5,
        "units": "fps",
        "description": "Animation frame rate"
    },
    "fx-head": {
        "type": "header",
        "description": "Window animations"
    },
    "window-effects": {
        "type": "checkbox",
        "default": true,
        "description": "Expand on open / contract on close (replaces Cinnamon's map and close effects)"
    },
    "effect-duration": {
        "type": "spinbutton",
        "default": 220,
        "min": 60,
        "max": 800,
        "step": 10,
        "units": "ms",
        "description": "Duration"
    },
    "pop-scale": {
        "type": "spinbutton",
        "default": 80,
        "min": 40,
        "max": 100,
        "step": 5,
        "units": "%",
        "description": "Start / end size"
    },
    "overshoot": {
        "type": "checkbox",
        "default": true,
        "description": "Overshoot (springy pop)"
    }
}