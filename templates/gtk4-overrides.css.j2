
/* ======================================================================
   Cinnabar overrides — {{ t.name }}  (GTK 4 / libadwaita)
   ====================================================================== */
window.csd, window.csd.ssd { border-radius: {{ w.radius }}px; }
window.csd.maximized, window.csd.fullscreen, window.csd.tiled, window.csd.tiled-top, window.csd.tiled-right, window.csd.tiled-bottom, window.csd.tiled-left { border-radius: 0; }
window.csd decoration, decoration {
  border-radius: {{ w.radius }}px;
  box-shadow: 0 8px 24px 2px {{ "#000000" | alpha(0.45) }}, 0 0 0 {{ w.border }}px {{ c.wm_border_focused }};
  margin: 12px;
}
window.csd decoration:backdrop, decoration:backdrop {
  box-shadow: 0 4px 14px 1px {{ "#000000" | alpha(0.28) }}, 0 0 0 {{ w.border }}px {{ c.wm_border_unfocused }};
}
window.csd.maximized decoration, window.csd.fullscreen decoration, .maximized decoration, .fullscreen decoration { border-radius: 0; box-shadow: none; }
window.csd.tiled decoration, .tiled decoration, .tiled-top decoration, .tiled-right decoration, .tiled-bottom decoration, .tiled-left decoration {
  border-radius: 0;
  box-shadow: 0 0 0 {{ w.border }}px {{ c.wm_border_focused }};
}
window.popup decoration, popover > contents, popover > arrow, .popup decoration, tooltip decoration, window.csd.popup decoration {
  box-shadow: 0 6px 18px {{ "#000000" | alpha(0.4) }}, 0 0 0 1px {{ c.fg | alpha(0.12) }};
  border-radius: {{ r.popup }}px;
}
window.ssd decoration, window.solid-csd decoration { border-radius: 0; box-shadow: none; }

headerbar, .top-bar headerbar, .titlebar {
  min-height: {{ w.titlebar_height }}px;
  background-color: {{ c.wm_bg }};
  color: {{ c.wm_title }};
}
headerbar:backdrop, .titlebar:backdrop { background-color: {{ c.wm_bg_unfocused }}; color: {{ c.wm_title_unfocused }}; }
window.csd > .titlebar, window.csd headerbar, window.csd .top-bar { border-radius: {{ w.radius }}px {{ w.radius }}px 0 0; }
window.csd.maximized > .titlebar, window.csd.maximized headerbar, window.csd.tiled headerbar, window.csd.fullscreen headerbar { border-radius: 0; }
headerbar .title { font-weight: 600; }

windowcontrols { border-spacing: 4px; margin: 0 6px; }
windowcontrols > button {
  min-width: {{ w.button_size }}px;
  min-height: {{ w.button_size }}px;
  padding: 0;
  margin: 0 2px;
  border-radius: 100%;
  box-shadow: inset 0 0 0 1px {{ "#000000" | alpha(0.18) }};
  background: {{ c.wm_button_unfocused }};
  color: transparent;
}
windowcontrols > button > image { background: none; padding: 0; border-radius: 0; -gtk-icon-size: 8px; opacity: 0; color: {{ "#000000" | alpha(0.65) }}; }
windowcontrols > button:hover > image { opacity: 1; }
windowcontrols > button.close { background: {{ c.red }}; }
windowcontrols > button.minimize { background: {{ c.yellow }}; }
windowcontrols > button.maximize { background: {{ c.green }}; }
windowcontrols > button:active { opacity: 0.8; }
windowcontrols > button:backdrop, windowcontrols > button.close:backdrop, windowcontrols > button.minimize:backdrop, windowcontrols > button.maximize:backdrop { background: {{ c.wm_button_unfocused }}; }
windowcontrols > button:hover, windowcontrols > button.close:hover, windowcontrols > button.minimize:hover, windowcontrols > button.maximize:hover { box-shadow: inset 0 0 0 1px {{ "#000000" | alpha(0.18) }}; }

popover > contents, popover.menu > contents, menu, .menu { border-radius: {{ r.popup }}px; padding: 6px; }
popover.menu modelbutton, menu menuitem, .menu menuitem { border-radius: {{ r.control }}px; }
.navigation-sidebar, .sidebar, .sidebar-pane, placessidebar { background-color: {{ c.bg_deep }}; }
.navigation-sidebar > row, placessidebar row { border-radius: {{ r.control }}px; margin: 1px 6px; }
.navigation-sidebar > row:selected, placessidebar row:selected { background-color: {{ c.accent | alpha(0.25) }}; color: {{ c.fg }}; }
scrollbar > range > trough > slider { border-radius: 99px; min-width: 6px; min-height: 6px; }
tooltip, tooltip > contents, tooltip.background { border-radius: {{ r.control }}px; background-color: {{ c.surface | alpha(0.97) }}; color: {{ c.fg }}; border: 1px solid {{ c.fg | alpha(0.12) }}; }
switch { border-radius: 99px; } switch > slider { border-radius: 99px; }
