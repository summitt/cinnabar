<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Cinnabar</vendor>
  <vendor_url>https://github.com/summitt/cinnabar</vendor_url>
  <action id="io.github.summitt.cinnabar.login">
    <description>Theme the login screen</description>
    <message>Authentication is required to install the Cinnabar login screen theme</message>
    <icon_name>cinnabar</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/cinnabar/login_root.py</annotate>
  </action>
</policyconfig>
